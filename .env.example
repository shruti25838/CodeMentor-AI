# "groq" is the actual code default (see codeatlas/utils/config.py); set to
# "openai" to use OpenAI instead.
CODEATLAS_LLM_PROVIDER=groq
CODEATLAS_LLM_MODEL=openai/gpt-oss-20b
CODEATLAS_LLM_TEMPERATURE=0.2
# Output budget per model call. A reasoning model spends part of it on reasoning before
# it writes the answer, so too small a budget returns an empty reply.
CODEATLAS_LLM_MAX_TOKENS=2048

# Put real keys in .env (do not commit)
OPENAI_API_KEY=
GROQ_API_KEY=

# Admin/debug endpoints (/explain, /search, /generate-code, POST /dependencies,
# /metrics, /docs, /redoc, /openapi.json) require an X-API-Key header matching
# CODEATLAS_API_KEY. With no key set they return 503. Endpoints the website
# calls never need a key. Never put this key in frontend code or NEXT_PUBLIC_*.
# Set CODEATLAS_AUTH_ENABLED=false only for local development.
CODEATLAS_API_KEY=
CODEATLAS_AUTH_ENABLED=true

# Frontend origins allowed to call the backend (comma-separated)
CODEATLAS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Optional storage dirs (Render: use /var/data)
CODEATLAS_INDEX_DIR=.codeatlas/indexes
CODEATLAS_STATE_DIR=.codeatlas/state

# Embedding provider: "hash" (default) needs no extra install and works
# out of the box, but is a hashed bag-of-words vector, not a semantic
# embedding, so retrieval quality is lower. "sentence" gives real semantic
# embeddings but requires `pip install sentence-transformers` (not in
# requirements.txt — a sizeable extra dependency) before it will work.
# "fastembed" also gives semantic embeddings, through ONNX on CPU rather
# than PyTorch, and requires `pip install -r requirements-fastembed.txt`
# (also not in requirements.txt). "cloudflare" gives semantic embeddings from
# an API and needs no install at all, but needs credentials and spends a daily
# free allowance. Any other name is rejected at startup with
# the list of valid ones, so a typo stops the app instead of quietly
# indexing with the wrong vectors.
CODEATLAS_EMBEDDING_PROVIDER=hash
CODEATLAS_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Used only when CODEATLAS_EMBEDDING_PROVIDER=fastembed; ignored otherwise.
# A transformer on CPU is far slower per document than the hash embedder, so
# this provider indexes one document at a time, embeds only the first 3,000
# characters of each, and replaces CODEATLAS_INDEX_TIMEOUT_SECONDS with its
# own longer limit. In Docker the model is baked in only when the image was
# built with --build-arg INSTALL_FASTEMBED=1, and that build argument must
# name the same model as CODEATLAS_FASTEMBED_MODEL; otherwise it is
# downloaded on first use.
CODEATLAS_FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
CODEATLAS_FASTEMBED_BATCH_SIZE=1
CODEATLAS_FASTEMBED_MAX_CHARS=3000
CODEATLAS_FASTEMBED_INDEX_TIMEOUT_SECONDS=900

# Used only when CODEATLAS_EMBEDDING_PROVIDER=cloudflare; ignored otherwise.
# Semantic embeddings from Cloudflare Workers AI over REST, needing no extra
# install: the call is made with the standard library. Needs an account id and
# an API token (below). The free allowance is 10,000 neurons per day and resets
# at 00:00 UTC, so the provider keeps its own running estimate in
# .codeatlas/cloudflare-neurons.json and stops calling at the daily budget,
# after which questions are answered from the hash index instead and the
# visitor is told so.
#
# The budget is 2,500 rather than something nearer the allowance because
# that ledger file is on local disk. A host without a persistent disk wipes
# it on every restart, and the guard then believes nothing has been spent
# today. At 2,500, four restart-cycles in one UTC day still fit inside the
# 10,000. Point CODEATLAS_NEURON_LEDGER at a persistent disk and the budget
# can go up.
#
# The guard is a courtesy, not the protection: its estimate has run from
# about 8% high to about 1.5% low against the account dashboard. The
# protection is that any refused call falls back to the hash index with a
# note the visitor can read.
#
# POOLING IS NOT A FREE CHOICE. "cls" and "mean" produce incompatible vectors
# (measured: cos 0.9466 between the same text under each), so an index built
# under one must never be searched under the other. The pooling is part of the
# embedder signature, so changing it here means every repository has to be
# analyzed again - which, for this provider, costs neurons. The same is true of
# the model and the per-document clip.
#
# The clip is 2,000 characters because the model reads about 512 tokens and
# silently ignores the rest; a longer document is embedded by its opening only.
# The document cap is per repository: a repository over it gets the hash index
# alone, with a note.
CODEATLAS_CLOUDFLARE_MODEL=@cf/baai/bge-small-en-v1.5
CODEATLAS_CLOUDFLARE_POOLING=mean
CODEATLAS_CLOUDFLARE_MAX_CHARS=2000
CODEATLAS_CLOUDFLARE_MAX_DOCUMENTS=600
CODEATLAS_CLOUDFLARE_BATCH_SIZE=50
CODEATLAS_CLOUDFLARE_DAILY_NEURONS=2500
CODEATLAS_CLOUDFLARE_TIMEOUT_SECONDS=30
CODEATLAS_CLOUDFLARE_RETRIES=2
CODEATLAS_CLOUDFLARE_FAILURE_THRESHOLD=3
CODEATLAS_CLOUDFLARE_COOLDOWN_SECONDS=300
CODEATLAS_CLOUDFLARE_INDEX_DIR=.codeatlas/indexes-cloudflare

# Credentials for the provider above. Put the real values in .env, never here,
# and never in frontend code or a NEXT_PUBLIC_ variable. They are read straight
# from the environment into an object with a redacting repr, and are never part
# of the app config, so no config dump or log can print them.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# How a question finds code, and how documents are indexed. Every default here is
# the one measured in docs/RESULTS.md; changing one changes the answers, so a
# value that is not a number, not between 0 and 1, or not a recognised on/off
# word stops the app starting rather than quietly reverting to the default.
#
# CANDIDATES: records taken from the vector search before reranking.
# RERANK_WEIGHT: 1.0 orders by keyword overlap with vector similarity breaking
#   ties; 0.0 keeps the vector order; in between mixes the two.
# RERANK_SUBTOKENS: also match the parts of identifiers (verify_signature ->
#   verify, signature).
# DROP_STOPWORDS: leave "how", "does", "the" and the like out of the question.
# SKIP_TESTS: drop records that come from test files.
# EMBED_MAX_CHARS: embed only the first N characters of each document; 0 means
#   no limit. The cloudflare provider has its own clip and ignores this.
# EMBED_PREFIX_METADATA: start each embedded document with its path and name.
#
# The last two change what is in an index, so changing either means earlier
# indexes are not reused by the index cache.
#
# Note: POST /search does NOT go through any of this. It embeds the query and
# returns what the index gives back, with no reranking, no stopword dropping,
# no test filtering and no fallback. It is a window onto the index, not a
# preview of what a visitor would be shown.
CODEATLAS_RETRIEVAL_CANDIDATES=20
CODEATLAS_RERANK_WEIGHT=1.0
CODEATLAS_RERANK_SUBTOKENS=false
CODEATLAS_DROP_STOPWORDS=true
CODEATLAS_SKIP_TESTS=false
CODEATLAS_EMBED_MAX_CHARS=0
CODEATLAS_EMBED_PREFIX_METADATA=true

# Limits when cloning a repo to index it. A repo over the limits, or a clone
# that takes too long, is rejected with a friendly error.
CODEATLAS_CLONE_TIMEOUT_SECONDS=60
CODEATLAS_MAX_REPO_MB=100
CODEATLAS_MAX_REPO_FILES=5000
# Time limit for building the search index after cloning. On timeout the clone
# and any partial index are deleted and the user gets a friendly 504.
CODEATLAS_INDEX_TIMEOUT_SECONDS=120
# Reuse an earlier index when the same repository URL is indexed again at the
# same commit (checked with git ls-remote, only if that URL was indexed before).
CODEATLAS_INDEX_CACHE=true
# Stop the download if the clone folder grows past this (default: 2x CODEATLAS_MAX_REPO_MB).
# CODEATLAS_MAX_DOWNLOAD_MB=200

# Per-client and global request limits (per minute) on endpoints that clone
# repositories (/analyze-repo) or call the LLM (/ask, /ask/stream, /explain,
# /generate-code). Over a limit returns 429 with Retry-After.
CODEATLAS_CLONE_PER_CLIENT_PER_MINUTE=10
CODEATLAS_CLONE_GLOBAL_PER_MINUTE=30
CODEATLAS_MAX_CONCURRENT_CLONES=3
CODEATLAS_LLM_PER_CLIENT_PER_MINUTE=60
CODEATLAS_LLM_GLOBAL_PER_MINUTE=300
CODEATLAS_RATE_LIMIT_MAX_CLIENTS=10000
# Number of proxies in front of the app that append to X-Forwarded-For.
# 0 = use the direct connection address. Set N only if exactly N proxies you
# control or trust sit in front of the app; check your host's docs first.
CODEATLAS_TRUSTED_PROXY_HOPS=0

# Chat memory for the website's streamed chat (/ask/stream with a session_id).
# Kept in server memory only, per browser chat and repository; never written to
# disk or logged. Lost on restart.
CODEATLAS_CHAT_HISTORY_TURNS=4
CODEATLAS_CHAT_HISTORY_TOKENS=1500
CODEATLAS_CHAT_SESSION_TTL_SECONDS=1800
CODEATLAS_CHAT_MAX_SESSIONS=1000

# Folder of retrieval eval results (scripts/eval_retrieval.py --json) read at startup into the
# codeatlas_retrieval_* gauges on /metrics. See docs/MONITORING.md.
CODEATLAS_EVAL_RESULTS_DIR=eval/results
