{
  "uid": "codementor",
  "title": "CodeMentor AI",
  "tags": [
    "codementor"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Retrieval hit rate (held-out eval questions)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "codeatlas_retrieval_hit_rate{split=\"test\"}",
          "legendFormat": "hit@{{k}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "description": "From eval/results/test.json, written by scripts/eval_retrieval.py. Not live traffic."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Retrieval MRR@10 (eval)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "codeatlas_retrieval_mrr",
          "legendFormat": "{{split}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "description": "From eval/results/*.json. Not live traffic."
    },
    {
      "id": 3,
      "type": "table",
      "title": "Eval run",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "codeatlas_retrieval_eval_info",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "Commit and embedder of the eval run the retrieval panels show."
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Requests per second by route",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (path) (rate(codeatlas_request_total{path!=\"/metrics\"}[5m]))",
          "legendFormat": "{{path}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {},
      "description": "Excludes /metrics. Prometheus scrapes this app every 15 s whether anyone is using it or not, which is 0.067 req/s of traffic nobody asked for - on a quiet site that is most of the graph, and it is the one route whose behaviour tells you nothing about the service."
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Errors per second",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (path, kind) (rate(codeatlas_errors_total[5m]))",
          "legendFormat": "{{path}} {{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {},
      "description": "http_5xx: 5xx responses; exception: unhandled; stream_error: error event inside a 200 chat stream."
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Chat question stages, p95 (/ask/stream)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(codeatlas_stage_duration_seconds_bucket{endpoint=\"ask_stream\"}[5m])))",
          "legendFormat": "{{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "description": "Per request; a stage run several times in one request is summed (the model is called 3 times per question)."
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Chat question stages, p50 (/ask/stream)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, stage) (rate(codeatlas_stage_duration_seconds_bucket{endpoint=\"ask_stream\"}[5m])))",
          "legendFormat": "{{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Indexing stages, p95 (/analyze-repo)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(codeatlas_stage_duration_seconds_bucket{endpoint=\"analyze\"}[5m])))",
          "legendFormat": "{{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "description": "clone, parse, graph, read_files, embed, index_write, save_state, total; cache hits show cache_lookup and remote_head."
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Response start latency p95 by route",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, path) (rate(codeatlas_request_latency_seconds_bucket{path!=\"/metrics\"}[5m])))",
          "legendFormat": "{{path}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "description": "Until the response started; for /ask/stream that is when the stream opened, not when it closed. Excludes /metrics. Prometheus scrapes this app every 15 s whether anyone is using it or not, which is 0.067 req/s of traffic nobody asked for - on a quiet site that is most of the graph, and it is the one route whose behaviour tells you nothing about the service."
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Responses by status",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (status) (rate(codeatlas_request_total{path!=\"/metrics\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {},
      "description": "Excludes /metrics. Prometheus scrapes this app every 15 s whether anyone is using it or not, which is 0.067 req/s of traffic nobody asked for - on a quiet site that is most of the graph, and it is the one route whose behaviour tells you nothing about the service."
    },
    {
      "id": 11,
      "type": "row",
      "title": "Semantic search",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Semantic index attempts per minute, by outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (outcome) (rate(codeatlas_semantic_index_total[5m])) * 60",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cpm"
        },
        "overrides": []
      },
      "options": {},
      "description": "Attempts to build a semantic index and how each one ended. Only the cloudflare provider builds one, so on a server running the hash default this panel is empty - which is itself the answer to 'is semantic search on here'."
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Estimated neurons spent per minute",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 37,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(codeatlas_semantic_index_estimated_neurons_total[5m]) * 60",
          "legendFormat": "estimated neurons"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cpm"
        },
        "overrides": []
      },
      "options": {},
      "description": "This app's own estimate of what indexing cost, not the provider's figure: measured against the account dashboard it has run from about 8% high to about 1.5% low. The free allowance is 10,000 neurons a day and resets at 00:00 UTC; the provider stops calling at CODEATLAS_CLOUDFLARE_DAILY_NEURONS, which defaults to 2,500."
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Questions answered from the fallback index per minute, by reason",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 37,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (reason) (rate(codeatlas_retrieval_fallback_total[5m])) * 60",
          "legendFormat": "{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cpm"
        },
        "overrides": []
      },
      "options": {},
      "description": "A question the semantic index could not answer, so the hash index answered it and the visitor was told so. The reason says whether there was no semantic index for that repository, the budget was gone, or the call itself failed."
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}
